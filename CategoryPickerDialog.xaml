<Window x:Class="TempNoteManager.CategoryPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбрать категорию"
        Width="440"
        Height="190"
        MinWidth="380"
        MinHeight="170"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Куда переместить выбранные файлы"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#1F2A36" />
        <ComboBox x:Name="CategoryBox"
                  Grid.Row="2"
                  Height="32"
                  DisplayMemberPath="DisplayTitle" />
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Отмена"
                    Width="86"
                    Height="32"
                    IsCancel="True" />
            <Button Content="Переместить"
                    Width="112"
                    Height="32"
                    Margin="10,0,0,0"
                    IsDefault="True"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
