<Window x:Class="TempNoteManager.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="900"
        Height="560"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Настройки"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#1F2A36" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Notepad++"
                           FontWeight="SemiBold"
                           Foreground="#1F2A36" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="session.xml"
                               VerticalAlignment="Center"
                               Foreground="#59677A" />
                    <TextBox x:Name="SessionPathBox"
                             Grid.Column="1"
                             Height="32"
                             Padding="8,4"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="2"
                            Content="…"
                            Margin="6,0,0,0"
                            ToolTip="Выбрать session.xml"
                            Click="BrowseSession_Click" />
                </Grid>

                <TextBlock Grid.Row="4"
                           Text="AI"
                           FontWeight="SemiBold"
                           Foreground="#1F2A36" />
                <StackPanel Grid.Row="6" Orientation="Horizontal">
                    <CheckBox x:Name="AiEnabledBox"
                              Content="Включить AI"
                              VerticalAlignment="Center" />
                    <CheckBox x:Name="AiAutoSummaryBox"
                              Content="Автоматически считать описание"
                              Margin="18,0,0,0"
                              VerticalAlignment="Center" />
                </StackPanel>
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Адрес API"
                               VerticalAlignment="Center"
                               Foreground="#59677A" />
                    <TextBox x:Name="AiEndpointBox"
                             Grid.Column="1"
                             Height="32"
                             Padding="8,4"
                             VerticalContentAlignment="Center" />
                </Grid>
                <Grid Grid.Row="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Модель"
                               VerticalAlignment="Center"
                               Foreground="#59677A" />
                    <TextBox x:Name="AiModelBox"
                             Grid.Column="1"
                             Height="32"
                             Padding="8,4"
                             VerticalContentAlignment="Center" />
                </Grid>
                <Grid Grid.Row="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="AI-ключ"
                               VerticalAlignment="Center"
                               Foreground="#59677A" />
                    <PasswordBox x:Name="AiKeyBox"
                                 Grid.Column="1"
                                 Height="32"
                                 Padding="8,4"
                                 VerticalContentAlignment="Center" />
                </Grid>

                <TextBlock Grid.Row="14"
                           Text="Хранилища"
                           FontWeight="SemiBold"
                           Foreground="#1F2A36" />
                <Grid Grid.Row="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Корзина"
                               VerticalAlignment="Center"
                               Foreground="#59677A" />
                    <ComboBox x:Name="TrashModeBox"
                              Grid.Column="1"
                              Height="32"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Корзина Windows" Tag="RecycleBin" />
                        <ComboBoxItem Content="Пользовательская папка" Tag="CustomFolder" />
                    </ComboBox>
                    <TextBox x:Name="TrashFolderBox"
                             Grid.Column="2"
                             Height="32"
                             Padding="8,4"
                             Margin="8,0,0,0"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="3"
                            Content="…"
                            Margin="6,0,0,0"
                            ToolTip="Выбрать папку пользовательской корзины"
                            Click="BrowseTrash_Click" />
                </Grid>
                <Grid Grid.Row="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Категории"
                               VerticalAlignment="Center"
                               Foreground="#59677A" />
                    <TextBox x:Name="CategoryRootBox"
                             Grid.Column="1"
                             Height="32"
                             Padding="8,4"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="2"
                            Content="…"
                            Margin="6,0,0,0"
                            ToolTip="Выбрать корневую папку категорий"
                            Click="BrowseCategoryRoot_Click" />
                </Grid>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Отмена"
                    Width="92"
                    Height="32"
                    IsCancel="True" />
            <Button Content="Сохранить"
                    Width="112"
                    Height="32"
                    Margin="10,0,0,0"
                    IsDefault="True"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
